#!/bin/sh

set -eu

script_dir=$(
  CDPATH= cd -- "$(dirname -- "$0")" && pwd
)
export PYTHONPATH="${script_dir}${PYTHONPATH:+:${PYTHONPATH}}"

find_python() {
  if [ -n "${PYTHON:-}" ]; then
    if "$PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
      printf '%s\n' "$PYTHON"
      return
    fi
    printf 'Labyrinth requires Python 3.11 or newer; PYTHON=%s is too old or unavailable.\n' "$PYTHON" >&2
    exit 1
  fi

  for candidate in \
    python3.14 \
    python3.13 \
    python3.12 \
    python3.11 \
    /Library/Frameworks/Python.framework/Versions/3.14/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.11/bin/python3 \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 \
    python3
  do
    if command -v "$candidate" >/dev/null 2>&1; then
      python_bin=$(command -v "$candidate")
    elif [ -x "$candidate" ]; then
      python_bin=$candidate
    else
      continue
    fi

    if "$python_bin" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
      printf '%s\n' "$python_bin"
      return
    fi
  done

  printf 'Labyrinth requires Python 3.11 or newer. Install a current Python or set PYTHON=/path/to/python3.11+.\n' >&2
  exit 1
}

python_bin=$(find_python)
exec "$python_bin" -m labyrinth build "$@"

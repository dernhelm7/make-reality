#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

usage() {
  cat <<EOF
Usage: ./preview-site [site-root] [publish-root] [port]

Defaults:
  site-root    $script_dir/site
  publish-root /tmp/labyrinth-preview
  port         8000

Examples:
  ./preview-site
  ./preview-site agent_docs/examples/reading-microfeatures /tmp/labyrinth-visual-check 8001
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

site_root=${1:-"$script_dir/site"}
publish_root=${2:-/tmp/labyrinth-preview}
port=${3:-8000}

find_python() {
  if [ -n "${PYTHON:-}" ]; then
    if "$PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
      printf '%s\n' "$PYTHON"
      return
    fi
    printf 'Labyrinth requires Python 3.11 or newer; PYTHON=%s is too old or unavailable.\n' "$PYTHON" >&2
    exit 1
  fi

  for candidate in \
    python3.14 \
    python3.13 \
    python3.12 \
    python3.11 \
    /Library/Frameworks/Python.framework/Versions/3.14/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.11/bin/python3 \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 \
    python3
  do
    if command -v "$candidate" >/dev/null 2>&1; then
      python_bin=$(command -v "$candidate")
    elif [ -x "$candidate" ]; then
      python_bin=$candidate
    else
      continue
    fi

    if "$python_bin" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
      printf '%s\n' "$python_bin"
      return
    fi
  done

  printf 'Labyrinth requires Python 3.11 or newer. Install a current Python or set PYTHON=/path/to/python3.11+.\n' >&2
  exit 1
}

python_bin=$(find_python)

case "$port" in
  ''|*[!0-9]*)
    printf 'Preview port must be a number, got %s.\n' "$port" >&2
    exit 1
    ;;
esac

if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
  printf 'Preview port must be between 1 and 65535, got %s.\n' "$port" >&2
  exit 1
fi

ensure_port_free() {
  if "$python_bin" -c '
import socket
import sys

port = int(sys.argv[1])
sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    sock.bind(("", port))
except OSError:
    raise SystemExit(1)
finally:
    sock.close()
' "$port"; then
    return
  fi

  printf 'Port %s is already in use. Stop that server or pass another port.\n' "$port" >&2
  exit 1
}

ensure_port_free

case "$site_root" in
  /*) ;;
  *) site_root="$script_dir/$site_root" ;;
esac

case "$publish_root" in
  /*) ;;
  *) publish_root="$script_dir/$publish_root" ;;
esac

PYTHON=$python_bin "$script_dir/build-site" --build-url "http://localhost:$port" "$site_root" "$publish_root"

printf 'Built %s\n' "$publish_root"
printf 'Previewing at http://localhost:%s\n' "$port"

# Python 3.14 still reads the process cwd while parsing http.server args.
cd /
exec "$python_bin" -m http.server "$port" --directory "$publish_root"
